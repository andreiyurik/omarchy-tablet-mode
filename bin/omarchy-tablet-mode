#!/usr/bin/env python3

"""Rotate a 2-in-1's panel from its accelerometer, with the touchscreen following.

Everything hardware-specific is detected at runtime rather than configured:
the internal panel, the digitizer and pen, the built-in keyboard and pointers,
and whichever fold sensor the machine exposes. What cannot be detected -- how
the accelerometer is mounted relative to the panel -- is a setting, because the
only way to establish it is to turn the machine and look.

Nothing is written into ~/.config/hypr. The daemon applies everything to the
running compositor with `hyprctl eval`, and applies it again after every
config reload, since a reload rebuilds monitor rules and binds from the files.

Subcommands:
  daemon    follow the accelerometer and the fold (the plugin's Service runs this)
  rotate    set orientation by hand: normal|right|inverted|left|next|prev
  lock      freeze the current orientation: on|off|toggle
  fold      record a fold switch event: on|off (Hyprland's switch binds run this)
  keyboard  show or hide the on-screen keyboard plugin: show|hide|toggle
  status    report state as JSON, for the bar widget
  detect    print detected hardware, for bug reports
"""

import argparse
import glob
import json
import os
import re
import subprocess
import sys

PLUGIN_ID = "andreiyurik.tablet-mode"
CLI = os.path.abspath(__file__)

HOME = os.path.expanduser("~")
CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
STATE_DIR = os.path.join(
    os.environ.get("XDG_STATE_HOME") or os.path.join(HOME, ".local/state"),
    "omarchy/tablet-mode",
)
DEVICES_CONF = os.path.join(STATE_DIR, "devices.conf")
LOCK_FILE = os.path.join(STATE_DIR, "locked")
FOLD_FILE = os.path.join(STATE_DIR, "folded")

SHELL_JSON = os.path.join(CONFIG_HOME, "omarchy/shell.json")

# The Lua global holding the switch binds this daemon made, so a restarted
# daemon can take the old ones down before binding again. A config reload
# clears both the binds and the global.
BINDS_GLOBAL = "omarchy_tablet_mode_binds"

# Present when iio-sensor-proxy is installed. Without the package the sensor
# never appears on the bus, which from the outside looks exactly like a machine
# with no accelerometer -- and those two need very different advice.
SENSOR_PROXY_POLICY = "/usr/share/dbus-1/system.d/net.hadess.SensorProxy.conf"

# On-screen keyboards from the Omarchy plugin directory, in order of
# preference, the tested one first: plugin id, name, and the omarchy-shell
# target and methods that show, hide and toggle it. Two are plain panels,
# opened and closed through the shell's own summon and hide; one has an IPC
# target of its own, untested, and so comes last. The first one
# enabled is the one the panel's button opens, and opening the machine puts
# it away.
KEYBOARDS = [
    ("io.github.abdxdev.onscreen-keyboard", "On-Screen Keyboard", None),
    ("io.github.frostmute.tablet-keyboard", "Omaqwerty", None),
    ("io.github.mtolhuys.onscreen-keyboard", "On-Screen Keyboard",
     {"show": ["onscreen-keyboard", "show"], "hide": ["onscreen-keyboard", "hide"],
      "toggle": ["onscreen-keyboard", "toggle"]}),
]

# Omarchy's toggles. Hardcoded to ~/.local/state, as its toggle tools write
# there regardless of XDG_STATE_HOME.
OMARCHY_TOGGLES = os.path.join(HOME, ".local/state/omarchy/toggles/hypr")
OMARCHY_DISABLED_INPUT = [
    os.path.join(OMARCHY_TOGGLES, "%s-disabled-name" % kind)
    for kind in ("touchpad", "touchscreen")
]
PANEL_OFF_TOGGLES = ("internal-monitor-clamshell", "internal-monitor-disable")

# Fold sensors that report their current state in sysfs. The switch events
# Hyprland delivers cover every machine with SW_TABLET_MODE, but an event only
# says what changed; these say where things stand, so they win when present.
TABLET_SYSFS = [
    "/sys/devices/platform/thinkpad_acpi/hotkey_tablet_mode",
    "/sys/devices/platform/asus-nb-wmi/tablet_mode",
    "/sys/devices/platform/hp-wmi/tablet",
]

SW_TABLET_MODE = 1  # bit in the evdev switch capabilities, linux/input-event-codes.h

# Switch devices some drivers register only when the switch first changes:
# intel-hid on the first fold, and intel-vbtn where it cannot tell the machine
# is a convertible. They are bound by name before they exist, or the fold that
# creates them would go unheard -- on many machines, the only fold sensor there
# is. A bind for a device that never appears does nothing.
LAZY_TABLET_SWITCHES = ("Intel HID switches", "Intel Virtual Switches")

ORIENTATIONS = ["normal", "right-up", "bottom-up", "left-up"]

# iio-sensor-proxy's orientation to a Hyprland transform, per accelerometer
# mounting. "standard" is the convention GNOME's mutter and iio-hyprland both
# use: the left edge up is a quarter turn counter-clockwise (transform 1), the
# right edge up three quarters (transform 3). It is right for every machine
# whose sensor is mounted, or corrected in systemd's hwdb, as it should be;
# the rest describe what is mirrored when it is not.
MAPPINGS = {
    "standard": {"normal": 0, "right-up": 3, "bottom-up": 2, "left-up": 1},
    "portrait-swapped": {"normal": 0, "right-up": 1, "bottom-up": 2, "left-up": 3},
    "landscape-swapped": {"normal": 2, "right-up": 3, "bottom-up": 0, "left-up": 1},
    "rotated-180": {"normal": 2, "right-up": 1, "bottom-up": 0, "left-up": 3},
}


def resolve_mapping(name):
    """The mounting to use: the named one, or standard for anything else --
    including "auto", which versions before 1.6 saved as the default."""
    return name if name in MAPPINGS else "standard"


def desired_transform(mapping, is_locked, is_folded, orientation, recorded):
    """Where the panel should stand, or None when there is nothing to go on.

    Open as a laptop, the screen stands upright. Folded, or with no way of
    knowing, it follows the sensor -- a machine whose fold goes unreported
    still turns, and a laptop standing on a desk reads upright anyway.

    The recorded transform is what was last applied on purpose. It is held
    while locked, and whenever the sensor has no reading to offer -- which is
    also what puts the panel back after a config reload has straightened it.
    """
    if is_locked:
        return recorded
    if is_folded is False:
        return 0
    return mapping.get(orientation, recorded)


def log(message):
    print("omarchy-tablet-mode: %s" % message, file=sys.stderr, flush=True)


# A compositor that stops answering must not hang the daemon, or a switch
# bind's `fold` along with it.
HYPRCTL_TIMEOUT = 5


def hyprctl(*args, parse_json=True):
    cmd = ["hyprctl"]
    if parse_json:
        cmd.append("-j")
    cmd.extend(args)
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, check=True,
                             timeout=HYPRCTL_TIMEOUT).stdout
    except (subprocess.CalledProcessError, subprocess.TimeoutExpired, FileNotFoundError):
        return None
    if not parse_json:
        return out
    try:
        return json.loads(out)
    except ValueError:
        return None


def lua_string(value):
    """A Lua string literal. Callers have already refused control characters."""
    return '"%s"' % str(value).replace("\\", "\\\\").replace('"', '\\"')


def hypr_eval(statements):
    """Run Lua in the live compositor, the way Omarchy's own monitor tools do.

    `hyprctl keyword` is refused on a Lua config, but `hyprctl eval` changes the
    running state immediately and without a reload.
    """
    if not statements:
        return True
    code = " ".join(statements)
    try:
        result = subprocess.run(["hyprctl", "eval", code], capture_output=True, text=True,
                                timeout=HYPRCTL_TIMEOUT)
    except subprocess.TimeoutExpired:
        log("hyprctl eval timed out")
        return False
    except FileNotFoundError:
        return False
    if result.returncode != 0 or result.stdout.startswith("error"):
        log("hyprctl eval failed: %s" % (result.stdout or result.stderr).strip())
        return False
    return True


def printable(name):
    # Device names come from USB descriptors and firmware. They are only ever
    # handled as data, but a newline would still forge a line in devices.conf.
    return bool(name) and not re.search(r"[\x00-\x1f\x7f]", name)


def read_text(path):
    try:
        with open(path) as handle:
            return handle.read().strip()
    except OSError:
        return None


# ---------------------------------------------------------------- detection


def hypr_name(name):
    """The name Hyprland gives a libinput device: lowercase, spaces as dashes."""
    return name.lower().replace(" ", "-")


def kernel_input_devices():
    """Every evdev node, with the udev properties and switches it carries.

    udev's database is world-readable, and its ID_INTEGRATION says whether a
    device is built in -- which is what separates the laptop's own keyboard
    from a USB one, or its digitizer from a drawing tablet on the desk.
    """
    devices = []
    for node in sorted(glob.glob("/sys/class/input/event*")):
        name = read_text(os.path.join(node, "device/name"))
        if not printable(name):
            continue

        props = {}
        dev = read_text(os.path.join(node, "dev"))
        try:
            with open("/run/udev/data/c%s" % dev) as handle:
                for line in handle:
                    if line.startswith("E:") and "=" in line:
                        key, value = line[2:].rstrip("\n").split("=", 1)
                        props[key] = value
        except (OSError, TypeError):
            pass

        # The bitmask is printed as space-separated words, most significant
        # first; the switches that matter all live in the last one.
        words = (read_text(os.path.join(node, "device/capabilities/sw")) or "0").split()
        try:
            switches = int(words[-1], 16)
        except (IndexError, ValueError):
            switches = 0

        devices.append({"name": name, "props": props, "switches": switches})
    return devices


def internal_names(kernel, *kinds):
    """Hyprland names of built-in devices of the given udev kinds, or None
    when udev says nothing about integration and there is nothing to go on."""
    if not any("ID_INTEGRATION" in d["props"] for d in kernel):
        return None
    return {
        hypr_name(d["name"]) for d in kernel
        if d["props"].get("ID_INTEGRATION") == "internal"
        and any(d["props"].get("ID_INPUT_%s" % kind) == "1" for kind in kinds)
    }


def matches(name, names):
    # Hyprland suffixes a repeated name with -1, -2... for the second node of a
    # device that is both a keyboard and a mouse.
    return name in names or re.sub(r"-\d+$", "", name) in names


def detect_panel():
    """The built-in panel, enabled or not -- the match Omarchy's own
    omarchy-hyprland-monitor-laptop makes.

    Never any other output. With the lid shut and a display attached, Omarchy
    switches the panel off, and an external monitor left as the only one would
    otherwise be taken for it: bound to the touchscreen, and turned whenever
    the laptop is moved.
    """
    for monitor in hyprctl("monitors", "all") or []:
        if re.match(r"^(eDP|LVDS|DSI)-", monitor.get("name", "")):
            return monitor
    return None


def panel_off(panel):
    """Whether the panel is off, or held off by one of Omarchy's toggles.

    Omarchy switches it off with a monitor rule of its own (lid shut with a
    display attached, or by hand). Any rule we set for the panel -- live or on
    reload -- would switch it straight back on.
    """
    return bool(panel.get("disabled")) or any(
        os.path.exists(os.path.join(OMARCHY_TOGGLES, "%s.lua" % toggle))
        for toggle in PANEL_OFF_TOGGLES
    )


def detect_touch_devices(devices, kernel):
    """The built-in digitizer and pen, which have to turn with the panel."""
    names = [d.get("name") for d in devices.get("touch", []) + devices.get("tablets", [])]
    names = [n for n in names if n and printable(n)]
    internal = internal_names(kernel, "TOUCHSCREEN", "TABLET")
    if internal is None:
        return names
    return [n for n in names if matches(n, internal)]


def detect_internal_devices(devices, kernel):
    """Built-in keyboard and pointers, which face the table once folded back.

    Bluetooth and USB peripherals must not be caught here: someone typing on an
    external keyboard with the machine folded into a stand still wants it. Nor
    the power button and hotkeys, which udev tags as keys but not a keyboard.
    """
    names = [d.get("name") for d in devices.get("keyboards", []) + devices.get("mice", [])]
    names = [n for n in names if n and printable(n)]

    internal = internal_names(kernel, "KEYBOARD", "TOUCHPAD", "POINTINGSTICK", "MOUSE")
    if internal is not None:
        return [n for n in names if matches(n, internal)]

    # No udev database to ask: fall back to names. The AT/PS2 controller is the
    # built-in keyboard on every x86 laptop.
    return [
        n for n in names
        if "at-translated-set-2" in n
        or re.search(r"(touchpad|trackpoint|synaptics|syna\d|tpps)", n, re.I)
    ]


def detect_tablet_switches(devices, kernel):
    """Every input device reporting SW_TABLET_MODE, by the name Hyprland's
    switch binds match on -- the built-in ones, when udev can tell.

    All of them, not one: a ThinkPad has two, one from thinkpad_acpi and one
    intel-hid adds after the first fold, and which of them speaks is not
    something to guess.
    """
    known = {s.get("name") for s in devices.get("switches", [])}
    candidates = [
        d for d in kernel
        if d["switches"] & (1 << SW_TABLET_MODE) and d["name"] in known
    ]
    internal = [d for d in candidates if d["props"].get("ID_INTEGRATION") == "internal"]
    return [d["name"] for d in internal or candidates]


def sensor_proxy_installed():
    return os.path.exists(SENSOR_PROXY_POLICY)


def detect_tablet_sysfs():
    for path in TABLET_SYSFS:
        if os.access(path, os.R_OK):
            return path
    return None


def detect_model():
    """The machine's name, as DMI reports it.

    Worth having in `detect` output, so a report says which machine it is.
    """
    for path in ("/sys/class/dmi/id/product_version",
                 "/sys/class/dmi/id/product_name"):
        value = read_text(path)
        # Vendors leave placeholders in one field and the real name in the
        # other, so skip the obvious filler.
        if value and value.lower() not in ("to be filled by o.e.m.", "default string",
                                           "system product name", "none"):
            return value
    return None


def detect():
    devices = hyprctl("devices") or {}
    kernel = kernel_input_devices()
    return {
        "model": detect_model(),
        "panel": panel_name(detect_panel()),
        "touch": detect_touch_devices(devices, kernel),
        "internal": detect_internal_devices(devices, kernel),
        "tablet_switch": detect_tablet_switches(devices, kernel),
        "tablet_sysfs": detect_tablet_sysfs(),
        "sensor_proxy": sensor_proxy_installed(),
    }


def panel_name(panel):
    # The name goes into Lua evaluated by the compositor, so only a plain
    # connector name may pass.
    name = (panel or {}).get("name") or ""
    return name if re.match(r"^[A-Za-z0-9._-]+$", name) else None


# -------------------------------------------------------------------- state


LIST_KEYS = ("touch", "internal", "tablet_switch")


def read_conf():
    conf = {key: [] for key in LIST_KEYS}
    try:
        with open(DEVICES_CONF) as handle:
            for line in handle:
                line = line.rstrip("\n")
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, value = line.split("=", 1)
                if key in LIST_KEYS:
                    conf[key].append(value)
                elif value:
                    conf[key] = value
    except OSError:
        pass
    return conf


def write_conf(conf):
    """The hardware found and the orientation last applied on purpose.

    Plain key=value. Returns whether anything changed.
    """
    lines = ["# Written by omarchy-tablet-mode. Edited by hand, it will be overwritten."]
    for key in ("panel", "mode", "position", "scale", "transform", "tablet_sysfs"):
        value = conf.get(key)
        if value is not None and value != "" and printable(str(value)):
            lines.append("%s=%s" % (key, value))
    for key in LIST_KEYS:
        lines += ["%s=%s" % (key, name) for name in conf.get(key, []) if printable(name)]
    text = "\n".join(lines) + "\n"

    if read_text(DEVICES_CONF) == text.strip():
        return False
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = DEVICES_CONF + ".tmp"
    with open(tmp, "w") as handle:
        handle.write(text)
    os.replace(tmp, DEVICES_CONF)
    return True


def refresh_conf(updates=None):
    """Re-detect hardware, keeping the orientation already recorded."""
    conf = read_conf()
    conf.update(detect())
    for key in ("model", "sensor_proxy"):
        conf.pop(key, None)
    conf.update(updates or {})
    return conf, write_conf(conf)


def plugin_entry(plugin_id=PLUGIN_ID):
    """A plugin's entry in shell.json, this one's by default, or None when
    that plugin is disabled.

    A third-party plugin is enabled exactly when its entry is there, and the
    entry carries the widget's settings inline. Reading them here means the
    daemon never depends on the widget passing them along -- which breaks
    whenever the shell reloads one without the other.
    """
    try:
        with open(SHELL_JSON) as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        return None

    def find(node):
        if isinstance(node, dict):
            if node.get("id") == plugin_id:
                return node
            node = list(node.values())
        if isinstance(node, list):
            for child in node:
                found = find(child)
                if found is not None:
                    return found
        return None

    return find(data)


def plugin_enabled():
    return plugin_entry() is not None


def find_keyboard():
    """The on-screen keyboard to use: the first known one that is enabled."""
    for keyboard in KEYBOARDS:
        if plugin_entry(keyboard[0]) is not None:
            return keyboard
    return None


def keyboard_command(keyboard, action):
    """The omarchy-shell command that shows, hides or toggles a keyboard."""
    plugin_id, _name, ipc = keyboard
    if ipc:
        return ["omarchy-shell"] + ipc[action]
    method = {"show": "summon", "hide": "hide", "toggle": "toggle"}[action]
    return ["omarchy-shell", "shell", method, plugin_id] + ([] if action == "hide" else ["{}"])


def run_keyboard(action, keyboard=None, on_panel=False):
    """Show, hide or toggle the on-screen keyboard, if there is one.

    A keyboard opens on the focused monitor. On a fold that ought to be the
    laptop's own panel -- the machine was folded to be used as a tablet -- so
    with `on_panel` the panel is focused first when an external monitor has
    the focus.
    """
    keyboard = keyboard or find_keyboard()
    if not keyboard:
        return False
    if on_panel:
        panel = detect_panel()
        name = panel_name(panel)
        if name and not panel_off(panel) and not panel.get("focused"):
            hyprctl("dispatch", "hl.dsp.focus({ monitor = %s })" % lua_string(name),
                    parse_json=False)
    try:
        subprocess.Popen(keyboard_command(keyboard, action), stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        return False
    return True


def locked():
    """Whether the rotation is locked in this session.

    The lock is tagged with the Hyprland instance, like a fold event: a
    portrait lock left from before a reboot must not turn a laptop sideways
    at the next login.
    """
    return read_text(LOCK_FILE) == os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")


def set_lock(on):
    os.makedirs(STATE_DIR, exist_ok=True)
    if on:
        with open(LOCK_FILE, "w") as handle:
            handle.write(os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "") + "\n")
    else:
        try:
            os.remove(LOCK_FILE)
        except OSError:
            pass


def opened(before, now):
    """Whether a change of the lid opens a folded machine into a laptop.

    Only an actual change from folded counts: the daemon's first reading
    after a start or a reload says nothing new.
    """
    return before is True and now is False


def on_opened():
    """A laptop again: its screen stands upright and its own keyboard is back.

    The lock goes, and so does the on-screen keyboard, however it was opened;
    hiding one that is not showing does nothing.
    """
    if locked():
        set_lock(False)
        log("unfolded: rotation lock released")
    run_keyboard("hide")


def fold_event():
    """The last switch event, True or False, or None if there has been none.

    Tagged with the Hyprland instance that delivered it: a file left over from
    before a logout says nothing about the lid now. Any switch counts,
    including one registered only after detection, as intel-hid's is.
    """
    parts = (read_text(FOLD_FILE) or "").split()
    signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    if len(parts) == 2 and parts[0] == signature:
        return parts[1] == "1"
    return None


def has_fold_sensor(conf):
    return bool(conf.get("tablet_sysfs") or conf.get("tablet_switch")
                or fold_event() is not None)


def folded(conf=None):
    """True or False, or None when nothing has reported the fold.

    A sysfs state wins: it says where things stand, where an event only says
    what changed. A machine with a switch but no event yet starts out open.
    With nothing at all, the fold is unknown, and the screen follows the
    sensor rather than stay put on a machine that never says it folded.
    """
    conf = conf or read_conf()

    sysfs = conf.get("tablet_sysfs")
    if sysfs:
        value = read_text(sysfs)
        if value is not None:
            return value == "1"

    event = fold_event()
    if event is not None:
        return event

    return False if has_fold_sensor(conf) else None


def omarchy_disabled_input():
    return {name for name in map(read_text, OMARCHY_DISABLED_INPUT) if name}


# ------------------------------------------------------------------- input


def apply_input(is_folded, conf=None):
    """Switch the built-in keyboard and pointers off while folded, on otherwise.

    Anything Omarchy's own touchpad toggle has switched off stays off: turning
    it back on is that toggle's business, not ours.
    """
    conf = conf or read_conf()
    held_off = omarchy_disabled_input()
    statements = []
    for name in conf.get("internal", []):
        if not is_folded and name in held_off:
            continue
        statements.append("hl.device({ name = %s, enabled = %s })"
                          % (lua_string(name), "false" if is_folded else "true"))
    return hypr_eval(statements)


def bind_statements(conf):
    """Lua that binds every tablet mode switch to `fold`, first taking down
    whatever binds an earlier daemon in this session left.

    Hyprland receives SW_TABLET_MODE from libinput with no extra permissions,
    on every vendor that reports it. Every switch detected is bound, and so
    are the ones intel-hid and intel-vbtn only register when the switch first
    changes: bound ahead, the fold that creates them is heard too. Locked, so
    folding still switches the keyboard off at the lock screen.
    """
    registry = BINDS_GLOBAL
    statements = [
        "%s = %s or {}" % (registry, registry),
        "for _, b in ipairs(%s) do pcall(function() b:unbind() end) end" % registry,
        "%s = {}" % registry,
    ]
    command = "'%s'" % CLI.replace("'", "'\\''")
    for name in dict.fromkeys(list(LAZY_TABLET_SWITCHES) + conf.get("tablet_switch", [])):
        for state in ("on", "off"):
            statements.append(
                "table.insert(%s, hl.bind(%s, hl.dsp.exec_cmd(%s), { locked = true }))"
                % (registry, lua_string("switch:%s:%s" % (state, name)),
                   lua_string("%s fold %s" % (command, state))))
    return statements


# ----------------------------------------------------------------- rotation


def apply_rotation(transform):
    """Turn the panel now through `hyprctl eval`, and record it for reloads.

    The live change needs no reload, so layer surfaces are left alone. The
    record is what the daemon turns the panel back to after a config reload,
    since that rebuilds the monitor rules from the files.
    """
    panel = detect_panel()
    name = panel_name(panel)
    if not name:
        log("no internal panel found")
        return 1
    if panel_off(panel):
        log("internal panel is off; not turning it")
        return 0

    # Mode, position and scale are carried over from the running monitor: a
    # per-output rule replaces the wildcard one outright, and "preferred" and
    # "auto" would drop a custom refresh rate or a multi-monitor layout.
    conf, _ = refresh_conf({
        "panel": name,
        "mode": "%dx%d@%s" % (panel["width"], panel["height"], panel["refreshRate"]),
        "position": "%dx%d" % (panel["x"], panel["y"]),
        "scale": panel["scale"],
        "transform": transform,
    })

    if int(panel.get("transform", 0)) == transform:
        return 0

    statements = [
        "hl.monitor({ output = %s, mode = %s, position = %s, scale = %s, transform = %d })"
        % (lua_string(name), lua_string(conf["mode"]), lua_string(conf["position"]),
           conf["scale"], transform)
    ]
    # Binding a digitizer to the output maps its coordinates into the panel but
    # does not rotate its axes; that takes a matching device transform.
    statements += [
        "hl.device({ name = %s, output = %s, transform = %d })"
        % (lua_string(touch), lua_string(name), transform)
        for touch in conf.get("touch", [])
    ]
    if not hypr_eval(statements):
        return 1
    return 0


def resolve_position(name, current):
    positions = {"normal": 0, "right": 1, "inverted": 2, "left": 3}
    if name in positions:
        return positions[name]
    if name == "next":
        return (current + 1) % 4
    if name == "prev":
        return (current + 3) % 4
    if name.isdigit() and 0 <= int(name) <= 3:
        return int(name)
    return None


def status(conf=None):
    conf = conf or read_conf()
    transform = int((detect_panel() or {}).get("transform", 0))
    return {
        "transform": transform,
        "orientation": ORIENTATIONS[transform % 4],
        "locked": locked(),
        "folded": folded(conf),
        "hasFoldSensor": has_fold_sensor(conf),
        "sensorInstalled": sensor_proxy_installed(),
        "keyboard": (find_keyboard() or (None, None))[1],
    }


# ------------------------------------------------------------------- daemon


def run_daemon(mapping_override=None):
    """Follow the accelerometer, the fold and the lock; print state as JSON lines.

    The Service reads stdout, so the widget changes the moment something
    happens instead of polling for it. The daemon keeps running on a machine
    without an accelerometer, or before iio-sensor-proxy has started: the fold
    and the lock still need handling, and the sensor is picked up when it
    appears on the bus.

    Settings come from the plugin's entry in shell.json and are re-read when
    that file changes, so changing one needs no restart. The arguments, for
    running by hand, override them.
    """
    import signal

    import gi

    gi.require_version("Gio", "2.0")
    from gi.repository import Gio, GLib

    bus_name = "net.hadess.SensorProxy"

    conf, _ = refresh_conf()
    if not has_fold_sensor(conf):
        log("no fold sensor found; following the accelerometer in every position")

    # "wired" is whether the switch binds are in place. A freshly loaded
    # config has none.
    state = {"proxy": None, "candidate": None, "folded": "unknown", "pending": False,
             "mapping": None, "wired": False}
    loop = GLib.MainLoop()

    def emit():
        data = status(conf)
        data["sensor"] = state["proxy"] is not None
        print(json.dumps(data), flush=True)

    def sync():
        state["pending"] = False
        is_folded = folded(conf)
        if not state["wired"]:
            # On a fresh start and after every config reload there are no
            # switch binds. The input state goes out again along with them.
            state["wired"] = hypr_eval(bind_statements(conf))
            state["folded"] = "unknown"
        if is_folded != state["folded"]:
            if opened(state["folded"], is_folded):
                on_opened()
            if is_folded is not None:
                apply_input(is_folded, conf)
                log("folded: following the sensor, built-in input off" if is_folded
                    else "unfolded: built-in input on")
            state["folded"] = is_folded

        settings = plugin_entry() or {}
        mapping_name = resolve_mapping(mapping_override or settings.get("mapping"))
        if mapping_name != state["mapping"]:
            log("accelerometer mounting: %s" % mapping_name)
            state["mapping"] = mapping_name

        proxy = state["proxy"]
        value = proxy.get_cached_property("AccelerometerOrientation") if proxy else None
        target = desired_transform(
            MAPPINGS[mapping_name], locked(), is_folded,
            value.get_string() if value else None,
            int(read_conf().get("transform") or 0),
        )

        panel = detect_panel()
        # A panel that is off stays off: no sensor reading is worth waking it.
        if target is not None and panel and not panel_off(panel):
            if target != int(panel.get("transform", 0)):
                apply_rotation(target)
        emit()
        return GLib.SOURCE_REMOVE

    def schedule(*_args):
        # Collapse a burst of events -- a lock toggled while the lid moves --
        # into one pass.
        if not state["pending"]:
            state["pending"] = True
            GLib.idle_add(sync)

    def on_properties_changed(_proxy, changed, _invalidated):
        if "AccelerometerOrientation" in changed.keys():
            schedule()

    def on_sensor_appeared(connection, _name, _owner):
        try:
            proxy = Gio.DBusProxy.new_sync(
                connection, Gio.DBusProxyFlags.NONE, None,
                bus_name, "/net/hadess/SensorProxy", bus_name, None,
            )
        except GLib.Error as error:
            log("iio-sensor-proxy unavailable: %s" % error.message)
            return
        if not proxy.get_cached_property("HasAccelerometer"):
            log("no accelerometer; manual rotation only")
            return
        state["candidate"] = proxy
        claim(proxy)

    def claim(proxy):
        """Claim the sensor, and keep trying if the claim fails.

        iio-sensor-proxy only polls the sensor while a client holds a claim.
        The call is asynchronous with a short timeout: a claim has been seen
        to hang, and it must neither freeze the fold and lock handling nor
        leave the daemon without a sensor for good.
        """
        if state["candidate"] is not proxy:
            return GLib.SOURCE_REMOVE  # the sensor went away meanwhile

        def done(source, result):
            if state["candidate"] is not proxy:
                return
            try:
                source.call_finish(result)
            except GLib.Error as error:
                log("could not claim the accelerometer, trying again: %s" % error.message)
                GLib.timeout_add_seconds(5, claim, proxy)
                return
            proxy.connect("g-properties-changed", on_properties_changed)
            state["proxy"] = proxy
            log("following the accelerometer")
            schedule()

        proxy.call("ClaimAccelerometer", None, Gio.DBusCallFlags.NONE, 5000, None, done)
        return GLib.SOURCE_REMOVE

    def on_sensor_vanished(_connection, _name):
        state["candidate"] = None
        if state["proxy"] is not None:
            log("iio-sensor-proxy went away")
            state["proxy"] = None
            schedule()

    Gio.bus_watch_name(Gio.BusType.SYSTEM, bus_name, Gio.BusNameWatcherFlags.AUTO_START,
                       on_sensor_appeared, on_sensor_vanished)

    # A config reload rebuilds monitor rules, binds and options from the files:
    # the panel straightens while the touchscreen stays turned, the switch
    # binds are gone. The daemon hears the reload and puts all of it back. The same goes for the
    # panel coming back on.
    def watch_hyprland():
        runtime = os.environ.get("XDG_RUNTIME_DIR", "")
        signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
        path = os.path.join(runtime, "hypr", signature, ".socket2.sock")
        try:
            connection = Gio.SocketClient.new().connect(Gio.UnixSocketAddress.new(path), None)
        except GLib.Error as error:
            log("cannot hear Hyprland's events, reloads will not be followed: %s"
                % error.message)
            return
        stream = Gio.DataInputStream.new(connection.get_input_stream())

        def on_line(source, result):
            try:
                line, _length = source.read_line_finish_utf8(result)
            except GLib.Error:
                line = None
            if line is None:
                return  # the compositor is gone, and the shell with it
            event = line.split(">>", 1)[0]
            if event == "configreloaded":
                state["wired"] = False
            if event in ("configreloaded", "monitoradded", "monitoraddedv2"):
                schedule()
            source.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)

        state["events"] = connection  # keep the socket alive
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, on_line)

    watch_hyprland()

    # The lock and switch events are files; a monitor reacts to them at once.
    os.makedirs(STATE_DIR, exist_ok=True)
    monitor = Gio.File.new_for_path(STATE_DIR).monitor_directory(Gio.FileMonitorFlags.NONE, None)

    def on_state_changed(_monitor, changed, _other, _event):
        if changed.get_path() in (LOCK_FILE, FOLD_FILE):
            schedule()

    monitor.connect("changed", on_state_changed)

    # The widget's settings are saved to shell.json; follow them from there.
    config = Gio.File.new_for_path(os.path.dirname(SHELL_JSON)).monitor_directory(
        Gio.FileMonitorFlags.NONE, None)

    def on_config_changed(_monitor, changed, _other, _event):
        if changed.get_path() == SHELL_JSON:
            schedule()

    config.connect("changed", on_config_changed)

    # sysfs raises no event of its own, so a fold sensor there is polled. It is
    # one small read; anything more expensive only happens on a change.
    if conf.get("tablet_sysfs"):
        def poll():
            if folded(conf) != state["folded"]:
                schedule()
            return GLib.SOURCE_CONTINUE

        GLib.timeout_add(1000, poll)

    # Quickshell stops the daemon with SIGTERM, which Python would otherwise
    # die of on the spot, skipping every cleanup below.
    try:
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        signal_add = GLibUnix.signal_add
    except (ValueError, ImportError):
        signal_add = GLib.unix_signal_add  # GLib before 2.80
    for signum in (signal.SIGTERM, signal.SIGINT, signal.SIGHUP):
        signal_add(GLib.PRIORITY_DEFAULT, signum, loop.quit)

    schedule()
    try:
        loop.run()
    finally:
        proxy = state["proxy"]
        if proxy is not None:
            try:
                proxy.call_sync("ReleaseAccelerometer", None, Gio.DBusCallFlags.NONE, -1, None)
            except GLib.Error:
                pass
        # A shell restart leaves things as they are, and the next daemon picks
        # up from there. A disable or removal must not leave the machine turned
        # with its keyboard switched off, or with its binds.
        if not plugin_enabled():
            restore()
    return 0


def restore():
    """Leave the compositor as the user's files have it.

    The panel and touchscreen are turned upright together and the built-in
    keyboard is given back first, in case a reload leaves a device as the
    plugin set it. The reload then takes down the switch binds and the
    panel's monitor rule, rebuilding both from the files.
    """
    set_lock(False)
    apply_rotation(0)
    apply_input(False)
    hyprctl("reload", parse_json=False)


# --------------------------------------------------------------------- main


def cmd_lock(action):
    if action == "toggle":
        action = "off" if locked() else "on"
    set_lock(action == "on")
    print("locked" if locked() else "unlocked")
    return 0


def cmd_fold(action):
    if not plugin_enabled():
        return 0  # a disabled plugin's switch binds linger until the next reload
    os.makedirs(STATE_DIR, exist_ok=True)
    tmp = FOLD_FILE + ".tmp"
    with open(tmp, "w") as handle:
        handle.write("%s %d\n" % (os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", ""),
                                  action == "on"))
    os.replace(tmp, FOLD_FILE)
    # Input is switched here rather than by the daemon, so the keyboard follows
    # the lid even while the shell is not running. By the event itself, not
    # folded(): sysfs may not have caught up with the switch yet. The daemon's
    # poll of sysfs puts right anything the event got wrong.
    apply_input(action == "on")
    return 0


def main():
    parser = argparse.ArgumentParser(prog="omarchy-tablet-mode", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)

    daemon = sub.add_parser("daemon", help="follow the accelerometer")
    daemon.add_argument("--mapping", choices=sorted(MAPPINGS),
                        help="override the setting in shell.json")

    rotate = sub.add_parser("rotate", help="set orientation by hand")
    rotate.add_argument("position")
    rotate.add_argument("--no-lock", action="store_true",
                        help="do not hold the orientation afterwards")

    lock = sub.add_parser("lock", help="freeze the current orientation")
    lock.add_argument("action", nargs="?", default="toggle",
                      choices=["on", "off", "toggle"])

    fold = sub.add_parser("fold", help="record a fold switch event")
    fold.add_argument("action", choices=["on", "off"])

    keyboard = sub.add_parser("keyboard", help="show or hide the on-screen keyboard")
    keyboard.add_argument("action", nargs="?", default="toggle", choices=["show", "hide", "toggle"])

    sub.add_parser("status", help="report state as JSON")
    sub.add_parser("detect", help="print detected hardware")

    args = parser.parse_args()

    if args.command == "daemon":
        return run_daemon(args.mapping)
    if args.command == "rotate":
        current = int((detect_panel() or {}).get("transform", 0))
        transform = resolve_position(args.position, current)
        if transform is None:
            log("unknown position %r" % args.position)
            return 2
        # Turning the screen by hand only sticks if the sensor stops arguing,
        # so it takes the lock -- and rotating back to normal releases it.
        if not args.no_lock:
            cmd_lock("off" if transform == 0 else "on")
        return apply_rotation(transform)
    if args.command == "lock":
        return cmd_lock(args.action)
    if args.command == "fold":
        return cmd_fold(args.action)
    if args.command == "keyboard":
        # Folded, the machine is a tablet, and the keyboard belongs on its own
        # panel even when an external monitor has the focus.
        on_panel = args.action != "hide" and folded() is True
        if run_keyboard(args.action, on_panel=on_panel):
            return 0
        log("no on-screen keyboard plugin is enabled")
        return 1
    if args.command == "status":
        print(json.dumps(status()))
        return 0
    if args.command == "detect":
        print(json.dumps(detect(), indent=2))
        return 0
    return 2


if __name__ == "__main__":
    sys.exit(main())
