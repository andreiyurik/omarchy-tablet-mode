#!/usr/bin/env python3

"""Draw the README artwork and the catalog preview.

Writes assets/icon.svg, assets/hero-dark.svg, assets/hero-light.svg and
preview.png (through rsvg-convert). Run it again after changing the words or
the colors; the SVGs are plain text, so the diff shows what changed.

The hero is scaled down to about two thirds on GitHub, so its words are drawn
large and kept to a few each.
"""

import math
import os
import subprocess

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
FONT = "Inter, 'Segoe UI', 'Helvetica Neue', Arial, 'Noto Sans', sans-serif"

THEMES = {
    "dark": {
        "bg": "#0d1017", "card": "#151a23", "edge": "#262d3a", "text": "#e8ecf2",
        "muted": "#8a93a6", "body": "#2a3140", "line": "#c9d1dd", "accent": "#7aa2f7",
        "glow": "#7aa2f7", "good": "#9ece6a", "off": "#f7768e", "mark": "#0d1017",
    },
    "light": {
        "bg": "#f5f7fb", "card": "#ffffff", "edge": "#e2e7ef", "text": "#1b2230",
        "muted": "#5d6778", "body": "#e6ebf3", "line": "#3a4454", "accent": "#3b6fe0",
        "glow": "#3b6fe0", "good": "#2f9e44", "off": "#d9485f", "mark": "#ffffff",
    },
}

CARDS = [
    ("laptop", "LAPTOP", ["Keyboard on", "Screen stays put"]),
    ("tent", "TENT", ["Turns upright", "Touch on target"]),
    ("tablet", "TABLET", ["Keyboard off", "On-screen keys"]),
]

SLAB = 16      # thickness of each half of the laptop
LENGTH = 176   # length of each half


def half(c, x, y, rotate, pivot, face=None, keys=None, keys_dim=False):
    """One half of the laptop, drawn from (x, y) downward and turned about pivot.

    face and keys name the side ("left" or "right" of the unturned slab) that
    carries the display or the keyboard.
    """
    px, py = pivot
    out = [f'<g transform="rotate({rotate} {px} {py})">',
           f'<rect x="{x - SLAB / 2}" y="{y}" width="{SLAB}" height="{LENGTH}" rx="{SLAB / 2}" '
           f'fill="{c["body"]}" stroke="{c["line"]}" stroke-width="3"/>']
    if face:
        fx = x + (3 if face == "right" else -7)
        out.append(f'<rect x="{fx}" y="{y + 14}" width="4" height="{LENGTH - 28}" rx="2" fill="{c["accent"]}"/>')
    if keys:
        kx = x + (4 if keys == "right" else -4)
        opacity = 0.35 if keys_dim else 0.9
        out.append(f'<path d="M{kx} {y + 22} V{y + LENGTH - 30}" stroke="{c["muted"]}" stroke-width="3" '
                   f'stroke-dasharray="6 5" opacity="{opacity}"/>')
    out.append("</g>")
    return out


def turn_arrow(c, cx, cy, r, start, end):
    """A circular arrow from angle start to end, in degrees, drawn clockwise."""
    def point(a):
        return cx + r * math.cos(math.radians(a)), cy + r * math.sin(math.radians(a))

    (sx, sy), (ex, ey) = point(start), point(end)
    large = 1 if (end - start) % 360 > 180 else 0
    # The head points along the tangent at the end of a clockwise turn.
    tangent = math.radians(end + 90)
    heads = []
    for spread in (150, -150):
        a = tangent + math.radians(spread)
        heads.append(f'M{ex:.1f} {ey:.1f} l{11 * math.cos(a):.1f} {11 * math.sin(a):.1f}')
    return [f'<path d="M{sx:.1f} {sy:.1f} A{r} {r} 0 {large} 1 {ex:.1f} {ey:.1f} {" ".join(heads)}" '
            f'stroke="{c["accent"]}" stroke-width="4" fill="none" stroke-linecap="round" '
            f'stroke-linejoin="round"/>']


def check(c, text, x, y):
    return [
        f'<circle cx="{x}" cy="{y}" r="13" fill="{c["good"]}"/>',
        f'<path d="M{x - 5.5} {y} l4 4 l7.5 -8" stroke="{c["mark"]}" stroke-width="3" '
        f'stroke-linecap="round" stroke-linejoin="round" fill="none"/>',
        f'<text x="{x + 26}" y="{y + 8}" font-family="{FONT}" font-size="24" font-weight="600" '
        f'fill="{c["text"]}">{text}</text>',
    ]


def card(c, kind, label, lines, x, y, w, h):
    cx, ground = x + w / 2, y + 262
    out = [
        f'<rect x="{x}" y="{y}" width="{w}" height="{h}" rx="24" fill="{c["card"]}" stroke="{c["edge"]}"/>',
        f'<text x="{x + 30}" y="{y + 50}" font-family="{FONT}" font-size="18" font-weight="700" '
        f'letter-spacing="3" fill="{c["muted"]}">{label}</text>',
        f'<path d="M{x + 28} {ground + 12} H{x + w - 28}" stroke="{c["edge"]}" stroke-width="3" '
        f'stroke-linecap="round"/>',
    ]

    if kind == "laptop":
        # The base lies flat, keys up; the screen stands from the hinge at the back.
        hx, hy = cx - 64, ground
        out.append(f'<rect x="{hx - SLAB / 2}" y="{hy - SLAB / 2}" width="{LENGTH}" height="{SLAB}" '
                   f'rx="{SLAB / 2}" fill="{c["body"]}" stroke="{c["line"]}" stroke-width="3"/>')
        out.append(f'<path d="M{hx + 20} {hy - 4} H{hx + LENGTH - 30}" stroke="{c["muted"]}" '
                   f'stroke-width="3" stroke-dasharray="6 5" opacity="0.9"/>')
        out += half(c, hx, hy - LENGTH, -14, (hx, hy), face="right")
    elif kind == "tent":
        # Folded over the top: the base on the left, keys out; the screen on
        # the right, facing whoever sits in front of it.
        top = ground - math.cos(math.radians(34)) * LENGTH
        out += half(c, cx, top, 34, (cx, top), keys="left")
        out += half(c, cx, top, -34, (cx, top), face="right")
        out += turn_arrow(c, cx + 104, top + 28, 26, 200, 110)
    else:
        # Folded flat: the screen on top, facing up; the keys underneath,
        # facing the table and switched off.
        base_y, screen_y = ground - SLAB / 2, ground - SLAB * 1.5 - 4
        left = cx - LENGTH / 2
        out.append(f'<rect x="{left}" y="{base_y - SLAB / 2}" width="{LENGTH}" height="{SLAB}" rx="{SLAB / 2}" '
                   f'fill="{c["body"]}" stroke="{c["line"]}" stroke-width="3"/>')
        out.append(f'<path d="M{left + 30} {base_y + 4} H{left + LENGTH - 20}" stroke="{c["muted"]}" '
                   f'stroke-width="3" stroke-dasharray="6 5" opacity="0.35"/>')
        out.append(f'<rect x="{left}" y="{screen_y - SLAB / 2}" width="{LENGTH}" height="{SLAB}" '
                   f'rx="{SLAB / 2}" fill="{c["body"]}" stroke="{c["line"]}" stroke-width="3"/>')
        out.append(f'<rect x="{left + 14}" y="{screen_y - 7}" width="{LENGTH - 28}" height="4" rx="2" '
                   f'fill="{c["accent"]}"/>')
        # The hinge, wrapped all the way round.
        out.append(f'<path d="M{left + 6} {screen_y} A{(base_y - screen_y) / 2 + 2} {(base_y - screen_y) / 2 + 2} '
                   f'0 0 0 {left + 6} {base_y}" stroke="{c["line"]}" stroke-width="3" fill="none"/>')
        # The pen, its tip on the glass.
        tip_x, tip_y = cx + 28, screen_y - 11
        out.append(f'<ellipse cx="{tip_x}" cy="{tip_y + 2}" rx="28" ry="6" fill="{c["glow"]}" opacity="0.45"/>')
        out.append(f'<g transform="rotate(34 {tip_x} {tip_y})">'
                   f'<rect x="{tip_x - 6}" y="{tip_y - 118}" width="12" height="104" rx="6" fill="{c["card"]}" '
                   f'stroke="{c["line"]}" stroke-width="3"/>'
                   f'<path d="M{tip_x - 5} {tip_y - 16} L{tip_x} {tip_y} L{tip_x + 5} {tip_y - 16}" '
                   f'fill="{c["line"]}"/></g>')

    for i, text in enumerate(lines):
        out += check(c, text, x + 44, y + h - 96 + i * 46)
    return out


def cards(c, top, height):
    width, gap, left = 346, 61, 60
    out = []
    for i, (kind, label, lines) in enumerate(CARDS):
        x = left + i * (width + gap)
        out += card(c, kind, label, lines, x, top, width, height)
        if i < len(CARDS) - 1:
            # Fold on to the next position.
            ax, ay = x + width + gap / 2, top + 190
            out.append(f'<path d="M{ax - 14} {ay} H{ax + 12} M{ax + 3} {ay - 9} L{ax + 13} {ay} '
                       f'L{ax + 3} {ay + 9}" stroke="{c["muted"]}" stroke-width="4" fill="none" '
                       f'stroke-linecap="round" stroke-linejoin="round"/>')
    return out


def icon_shapes(x, y, size):
    """A laptop folded into a tent, with the turn the screen makes."""
    k = size / 128
    ax, ay, leg, spread = 64, 46, 50, 34
    dx, dy = leg * math.sin(math.radians(spread)), leg * math.cos(math.radians(spread))

    # A clockwise arc over the top, its head pointing down the screen side.
    cx, cy, r = 64, 50, 30
    start, end = 215, 325
    sx, sy = cx + r * math.cos(math.radians(start)), cy + r * math.sin(math.radians(start))
    ex, ey = cx + r * math.cos(math.radians(end)), cy + r * math.sin(math.radians(end))
    tangent = math.radians(end + 90)
    heads = []
    for turn in (150, -150):
        a = tangent + math.radians(turn)
        heads.append(f'M{ex:.1f} {ey:.1f} l{12 * math.cos(a):.1f} {12 * math.sin(a):.1f}')
    return [
        f'<g transform="translate({x} {y}) scale({k})">',
        '<defs><linearGradient id="tm-g" x1="0" y1="0" x2="1" y2="1">'
        '<stop offset="0" stop-color="#8fb3ff"/><stop offset="1" stop-color="#5a7fe6"/></linearGradient></defs>',
        '<rect width="128" height="128" rx="30" fill="url(#tm-g)"/>',
        f'<path d="M{ax - dx:.1f} {ay + dy + 16:.1f} L{ax} {ay + 16} L{ax + dx:.1f} {ay + dy + 16:.1f}" '
        'stroke="#fff" stroke-width="10" stroke-linecap="round" stroke-linejoin="round" fill="none"/>',
        f'<path d="M{sx:.1f} {sy:.1f} A{r} {r} 0 0 1 {ex:.1f} {ey:.1f} {" ".join(heads)}" stroke="#fff" '
        'stroke-width="6" stroke-linecap="round" stroke-linejoin="round" fill="none" opacity="0.9"/>',
        '</g>',
    ]


def svg(width, height, body, background=None):
    bg = f'<rect width="{width}" height="{height}" fill="{background}"/>' if background else ""
    return (f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" '
            f'viewBox="0 0 {width} {height}">{bg}' + "".join(body) + "</svg>\n")


def write(path, text):
    with open(os.path.join(ROOT, path), "w") as handle:
        handle.write(text)


def main():
    write("assets/icon.svg", svg(128, 128, icon_shapes(0, 0, 128)))

    for name, c in THEMES.items():
        write("assets/hero-%s.svg" % name, svg(1280, 470, cards(c, 25, 420)))

    c = THEMES["dark"]
    title = [
        *icon_shapes(60, 46, 72),
        f'<text x="152" y="99" font-family="{FONT}" font-size="52" font-weight="800" fill="{c["text"]}">'
        f'Tablet Mode<tspan dx="16" font-weight="400" fill="{c["muted"]}">for Omarchy</tspan></text>',
        f'<text x="60" y="162" font-family="{FONT}" font-size="26" fill="{c["muted"]}">'
        'For 2-in-1 laptops that fold back 360°. Fold it, and Omarchy follows.</text>',
    ]
    preview = os.path.join(ROOT, "assets", ".preview.svg")
    with open(preview, "w") as handle:
        handle.write(svg(1280, 640, title + cards(c, 195, 420), background=c["bg"]))
    subprocess.run(["rsvg-convert", "-w", "1280", "-h", "640", "-o",
                    os.path.join(ROOT, "preview.png"), preview], check=True)
    os.remove(preview)


if __name__ == "__main__":
    main()
